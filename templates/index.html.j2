{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}

{% block jsonld %}
<script type="application/ld+json">{{ person_jsonld }}</script>
{% endblock %}

{% block scripts %}
<script src="/js/evidence.js" defer></script>
<script src="/js/clock.js" defer></script>
{% endblock %}

{% block content %}

{# ---- 01 / 04 IDENTITY (handoff §3, turn 2a) ---------------------------- #}
<section class="section section--identity">
  <div class="section-head">
    <span class="mono-label">01 / 04 — IDENTITY</span>
    <span class="mono-label">AS OF {{ github.as_of_display }}</span>
  </div>
  <h1 class="display-xl">{{ profile.identity_line }}</h1>
  <div class="rule-strip">
    <span>{{ profile.headline | upper }}</span>
    <span class="accent">{{ profile.years_experience }} YEARS — {{ employers | join(' · ') | upper }}</span>
    <span>{{ profile.location | upper }}</span>
  </div>
</section>

{# ---- 02 / 04 FLAGSHIP PROOF ------------------------------------------- #}
{# The A3.1 evidence-reveal layer is NOT built here. It is an animation, and
   handoff §5 assigns it to P3.3. Building its markup early would put a layer
   over these columns before its behaviour has been ruled on. #}
<section class="section section--ledger">
  <div class="section-head">
    <span class="mono-label">02 / 04 — FLAGSHIP PROOF</span>
    <span class="mono-meta">ENTRIES {{ '%02d' % (flagship | length) }}</span>
  </div>

  {% for p in flagship %}
  <article class="ledger-row" data-evidence-row>
    <span class="numeral">{{ '%02d' % loop.index }}</span>

    <div class="ledger-name">
      <span class="display-sm">{{ p.name }}</span>
      {# Every metric renders here. Desktop shows the first three by CSS; narrow
         viewports show all of them, because the A3.1 layer cannot open without
         a pointer and nothing may be reachable by hover alone. #}
      <span class="ledger-meta">
        {%- if p.get('metrics_pending') -%}
        {{ m.mark_cross() }}<span class="status--pending">{{ p.get('metrics_pending') | upper }}</span>
        {%- else -%}
        {{ m.mark_check() }}{% for metric in p.verified_metrics %}<span class="lm status--verified">{{ metric | upper }}</span>{% endfor %}
        {%- endif -%}
      </span>
    </div>

    <p class="quote-sm">{{ p.problem }}</p>

    <div class="ledger-links">
      {% for label, url in p.links.items() %}
      <a class="mono-link" href="{{ url }}" rel="noopener noreferrer">{{ label | replace('_', ' ') | upper }} ↗</a>
      {% endfor %}
      {{ m.anchor(p._anchor, 'AS OF') }}
    </div>

    {# A3.1. pointer-events:none, bounded in CSS to the name + problem columns
       only — the links column above is NEVER covered in any state
       (requirement 3.3). aria-hidden: it duplicates content already present in
       the row and on /projects/, so it is a reveal, not a source. #}
    <div class="evidence" aria-hidden="true">
      <span class="mono-label accent">VERIFIED EVIDENCE — NO. {{ '%02d' % loop.index }}</span>
      <div class="evidence-list">
        {% for metric in p.verified_metrics %}
        <span class="metric">{{ m.mark_check() }}{{ metric }}</span>
        {% endfor %}
      </div>
    </div>
  </article>
  {% endfor %}
</section>

{# ---- 03 / 04 TRUTH STRIP ----------------------------------------------
     The live IST clock is P3.3 (it needs JS). Everything here is static and
     sourced: each figure is that project's own first stated metric, carrying
     the version anchor it was stated against and a link to its repo. #}
<section class="truth-strip">
  <span class="mono-label accent">03 / 04</span>
  {# D6. Without JS this reads "SNAPSHOT <stamp>" — true, and visibly a
     snapshot. The live-indicator dot only appears once clock.js runs, so the
     dot always means "this is ticking" (requirement 3.7). #}
  <span class="truth-item" data-clock>
    {{ m.dot('accent clock-dot') }}
    {# Time only, not the full date: the date already appears in the identity
       strip above, and a shorter fallback means less reserved width for the
       CLS guard below (defect D-31). #}
    <span class="mono-meta" data-clock-text>SNAPSHOT {{ github.as_of_display.split(' ')[1] }} IST</span>
  </span>
  <span class="mono-meta">{{ profile.location | upper }}</span>
  {% for p in projects if p.verified_metrics %}
  <span class="truth-item">
    <span class="mono-meta">{{ p.name | upper }} — {{ p.verified_metrics[0] }}</span>
    {{ m.anchor(p._anchor) }}
  </span>
  {% endfor %}
</section>
{% endblock %}
