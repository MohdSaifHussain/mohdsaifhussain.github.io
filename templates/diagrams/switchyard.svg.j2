<svg class="diagram" data-post viewBox="0 0 1200 430" role="img" aria-labelledby="switchyard-diagram-title" xmlns="http://www.w3.org/2000/svg">
<title id="switchyard-diagram-title">Switchyard topology: clients reach the gateway pod in a kind cluster reconciled by Argo CD; the gateway and worker share Redis, Ollama and the OpenTelemetry collector</title>
<g class="d-item d-region"><rect class="d-boundary" x="260" y="20" width="360" height="300" rx="2"/><text class="d-eyebrow" x="272" y="36">KIND KUBERNETES CLUSTER: HELM CHART, RECONCILED BY ARGO CD</text></g>
<g class="d-item d-node d-node--box"><rect class="d-shape" x="0" y="120" width="174" height="42" rx="1"/><text class="d-label" x="87" y="138" text-anchor="middle">Client</text><text class="d-label" x="87" y="152" text-anchor="middle">OpenAI-format requests</text></g>
<g class="d-item d-node d-node--box"><rect class="d-shape" x="290" y="60" width="201" height="55" rx="1"/><text class="d-label" x="391" y="78" text-anchor="middle">Gateway pod</text><text class="d-label" x="391" y="92" text-anchor="middle">routing, fallback, quotas,</text><text class="d-label" x="391" y="104" text-anchor="middle">cost, tracing</text></g>
<g class="d-item d-edge d-edge--up"><line class="d-line" x1="174" y1="141" x2="290" y2="88"/><text class="d-edge-label" x="150" y="100" text-anchor="middle">POST /v1/chat/completions, /v1/jobs</text></g>
<g class="d-item d-node d-node--store"><rect class="d-shape" x="990" y="60" width="167" height="44" rx="8"/><text class="d-label" x="1074" y="80" text-anchor="middle">Ollama on the host</text><text class="d-label" x="1074" y="92" text-anchor="middle">qwen3:4b, llama3.2:1b</text></g>
<g class="d-item d-edge d-edge--up"><line class="d-line" x1="491" y1="88" x2="990" y2="82"/><text class="d-edge-label" x="760" y="70" text-anchor="middle">forwards completion</text></g>
<g class="d-item d-node d-node--store"><rect class="d-shape" x="700" y="130" width="249" height="42" rx="8"/><text class="d-label" x="825" y="148" text-anchor="middle">Redis</text><text class="d-label" x="825" y="162" text-anchor="middle">quotas, cost records, job streams</text></g>
<g class="d-item d-edge"><line class="d-line" x1="491" y1="88" x2="700" y2="151"/><text class="d-edge-label" x="590" y="130" text-anchor="middle">read quota, write cost, submit job</text></g>
<g class="d-item d-node d-node--box"><rect class="d-shape" x="290" y="210" width="229" height="42" rx="1"/><text class="d-label" x="404" y="228" text-anchor="middle">Worker pod</text><text class="d-label" x="404" y="242" text-anchor="middle">async jobs, same provider path</text></g>
<g class="d-item d-edge d-edge--back"><line class="d-line" x1="700" y1="151" x2="519" y2="231"/><text class="d-edge-label" x="615" y="205" text-anchor="middle">consumer group delivers the job</text></g>
<g class="d-item d-edge d-edge--up"><line class="d-line" x1="519" y1="231" x2="1074" y2="104"/><text class="d-edge-label" x="870" y="210" text-anchor="middle">routes and generates</text></g>
<g class="d-item d-node d-node--box"><rect class="d-shape" x="990" y="230" width="194" height="42" rx="1"/><text class="d-label" x="1087" y="248" text-anchor="middle">OpenTelemetry Collector</text><text class="d-label" x="1087" y="262" text-anchor="middle">to Prometheus, to Grafana</text></g>
<g class="d-item d-edge"><line class="d-line" x1="391" y1="115" x2="990" y2="251"/></g>
<g class="d-item d-edge"><line class="d-line" x1="519" y1="231" x2="990" y2="251"/><text class="d-edge-label" x="830" y="270" text-anchor="middle">gen_ai spans, metrics</text></g>
<g class="d-item d-node d-node--store"><rect class="d-shape" x="0" y="350" width="154" height="42" rx="8"/><text class="d-label" x="77" y="368" text-anchor="middle">This Git repository</text><text class="d-label" x="77" y="382" text-anchor="middle">Helm chart on main</text></g>
<g class="d-item d-node d-node--box"><rect class="d-shape" x="320" y="350" width="120" height="29" rx="1"/><text class="d-label" x="380" y="368" text-anchor="middle">Argo CD</text></g>
<g class="d-item d-edge d-edge--up"><line class="d-line" x1="154" y1="371" x2="320" y2="364"/><text class="d-edge-label" x="237" y="360" text-anchor="middle">GitOps source of truth</text></g>
<g class="d-item d-edge d-edge--up"><line class="d-line" x1="380" y1="350" x2="440" y2="320"/><text class="d-edge-label" x="520" y="345" text-anchor="middle">reconciles / self-heals</text></g>
</svg>
