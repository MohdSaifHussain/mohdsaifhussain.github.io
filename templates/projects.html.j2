{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}

{% block scripts %}
<script src="/js/diagram.js" defer></script>
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">{{ projects_jsonld }}</script>
{% endblock %}

{% block content %}
{# P5.8: one card, used by both sections. `kind` is the word after the
   position; `total` the count of the section it sits in. #}
{% macro card(p, index, total, kind) %}
  <article class="card">

    <div class="card-head">
      <span class="numeral">{{ '%02d' % index }}
        <span class="card-pos">/ {{ '%02d' % total }}
          {%- if kind %} · {{ kind }}{% elif p.get('flagship') %} · FLAGSHIP{% elif p.get('archived') %} · ARCHIVED{% endif -%}
        </span>
      </span>
      {% if p.get('metrics_pending') %}
      <span class="card-status">{{ m.mark_cross() }}<span class="status--pending">METRICS PENDING</span></span>
      {% else %}
      <span class="card-status">{{ m.mark_check() }}<span class="status--verified">VERIFIED</span></span>
      {% endif %}
    </div>

    <h2 class="display-md">{{ p.name }}</h2>
    <p class="quote">{{ p.problem }}</p>

    <div class="card-grid">
      <div class="card-col">
        <span class="mono-label">METHOD</span>
        <p class="mono-body">{{ p.method }}</p>
      </div>
      <div class="card-col">
        <span class="mono-label">VERIFIED METRICS</span>
        <div class="metrics">
          {% for metric in p.verified_metrics %}
          <span class="metric">{{ m.mark_check() }}{{ metric }}</span>
          {% endfor %}
          {% if p.get('metrics_pending') %}
          <span class="metric metric--pending">{{ m.mark_cross() }}{{ p.get('metrics_pending') }}</span>
          {% endif %}
        </div>
        <p class="mono-meta card-basis">{{ p._basis_sentence }}</p>
      </div>
    </div>

    {% if p.get('diagram') %}
    {# v1.2 (P5.4): the project's own architecture, transcribed from its README
       by tools/gen_diagrams.py, posts node by node and draws its edges as the
       figure reaches the reading edge (A3.7). The figure scrolls sideways
       inside its own frame when it is wider than the card (native, C-14), and
       the zoom controls, revealed by diagram.js, scale the drawing inside that
       same frame. #}
    <figure class="diagram-wrap">
      {# figcaption must be a direct child of figure (HTML content model); the
         W3C validator refused a div-wrapped one six times (D-67). The caption
         itself is the head row: label left, zoom controls right. #}
      <figcaption class="diagram-head">
        <span class="mono-label">ARCHITECTURE — FROM THE README</span>
        <span class="diagram-zoom" role="group" aria-label="Zoom the {{ p.name }} diagram">
          <button type="button" class="d-zoom" data-zoom="out" aria-label="Zoom out">−</button>
          <button type="button" class="d-zoom" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" class="d-zoom" data-zoom="reset">RESET</button>
        </span>
      </figcaption>
      {# The accessible name carries the project name: six regions named alike are
         one landmark six times to a screen reader, and axe refused the deploy
         for it (D-66). #}
      <div class="diagram-scroll" tabindex="0" role="region" aria-label="{{ p.name }} architecture diagram, scrollable">
        {% include 'diagrams/' ~ p.diagram ~ '.svg.j2' %}
      </div>
    </figure>
    {% endif %}

    {% if p.get('figure') %}
    {# P5.9: an entry whose README publishes a figure of its own carries THAT,
       in the slot another entry uses for its architecture. The drawing is the
       repository's own SVG with its colours replaced by classes
       (tools/gen_chart.py); its four lines of prose are rendered here as HTML
       because SVG text cannot wrap, and at phone widths those lines ran past
       the viewBox and were clipped by it. Same words, same order, wrapped.
       It does not animate: `.chart` is not `.diagram`, so diagram.js never
       arms it and the A3.7 ledger is untouched. #}
    <figure class="chart-wrap">
      <figcaption class="chart-head">
        <span class="mono-label">FIGURE — FROM THE README</span>
        <span class="mono-body chart-title">{{ p.figure.title }}</span>
        <span class="mono-meta">{{ p.figure.subtitle }}</span>
      </figcaption>
      {# One region per instance, named for its entry: six regions named alike
         are one landmark six times to a screen reader, and axe refused the
         deploy for exactly that (D-66). #}
      <div class="diagram-scroll" tabindex="0" role="region" aria-label="{{ p.name }} coverage chart, scrollable">
        {% include 'figures/' ~ p.figure.file ~ '.svg.j2' %}
      </div>
      {% for n in p.figure.notes %}
      <p class="mono-meta chart-note">{{ n }}</p>
      {% endfor %}
      <p class="mono-meta chart-note">Source: {{ p.figure.source }}</p>
    </figure>
    {% endif %}

    {% if p.get('outcome') %}
    {# P5.8: a case study's outcome, as its own README states it, in the slot
       a project uses for its architecture. A definition list: the README's
       row labels are the terms, its cells and sentences the values. #}
    <figure class="outcome-wrap">
      <figcaption class="mono-label">OUTCOME — FROM THE README</figcaption>
      {% for g in p.outcome.groups %}
      <div class="outcome-group">
        <span class="mono-label accent">{{ g.title }}</span>
        <dl class="outcome">
          {% for row in g.rows %}
          <div class="outcome-row">
            <dt class="mono-body">{{ row.k }}</dt>
            <dd class="mono-body">{{ row.v }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
      {% endfor %}
      <p class="mono-meta outcome-source">Source: {{ p.outcome.source }}</p>
    </figure>
    {% endif %}

    <div class="card-foot">
      {% if p.get('ai_collaboration') %}
      <span class="mono-meta">{{ p.ai_collaboration }}</span>
      {% else %}<span></span>{% endif %}
      <div class="card-links">
        {% for label, url in p.links.items() %}
        <a class="mono-link" href="{{ url }}" rel="noopener noreferrer">{{ label | replace('_', ' ') | upper }} ↗</a>
        {% endfor %}
      </div>
      {{ m.record(p) }}
    </div>

  </article>
{% endmacro %}


{# Handoff §3 (3a). The slider is native CSS scroll-snap — no JS carousel, no
   arrows. A3.2 in the animation list is precisely the declaration that this
   scrolling is native and nothing else moves; the layout is built here because
   the page cannot exist without it, and P3.3 verifies it against C-14/C-15 and
   records it in the audit list. Recorded as reading R-06.

   This is also the first page carrying BOTH marks — verified ✓ rows and
   TS-Sentry's pending ✗ — which discharges obligation O-9: MARK_DRIFT's first
   coverage of real dual-mark output. #}

<section class="section section--head">
  <div class="section-head">
    {# R-07, owner-directed deviation from handoff §3 (which specifies "Case
       ledger"): the h1 matches its nav label, per the anti-lost doctrine —
       C-13 wants the current location unambiguous. The ledger voice stays in
       the entries line below. #}
    <h1 class="display-lg">Projects</h1>
    <span class="mono-meta">{{ '%02d' % (projects | length) }} ENTRIES · SCROLL →</span>
  </div>
  {# P5.6 legend: the two dates every card carries, named by DCMI terms and
     sourced from the snapshot whose "as of" the footer prints. #}
  <p class="mono-meta record-legend">Newest MODIFIED first. ISSUED is the latest formal release of the anchored version (GitHub's published date). MODIFIED is the last push to the repository. Both from the snapshot as of {{ github.as_of_display }}.</p>
</section>

<div class="slider" tabindex="0" role="region" aria-label="Projects, scrollable">
  {% for p in projects %}
{{ card(p, loop.index, projects | length, '') }}
  {% endfor %}
</div>

{# ---- CASE STUDIES (P5.8) ----------------------------------------------
   Owner's direction 2026-08-28: a second section on this page only, below
   the projects, for the entries that are records of one engagement or one
   build rather than a tool. Same card, same gates, same order rule; the
   figure slot carries the outcome instead of an architecture. #}
<section class="section section--head section--cases">
  <div class="section-head">
    <h2 class="display-lg">Case studies</h2>
    <span class="mono-meta">{{ '%02d' % (case_studies | length) }} ENTRIES · SCROLL →</span>
  </div>
  <p class="mono-meta record-legend">A case study is the record of one engagement or one build, read end to end: what was asked, what was done, and what it showed. Each carries its outcome as its own README states it, with the lines cited.</p>
</section>

<div class="slider" tabindex="0" role="region" aria-label="Case studies, scrollable">
  {% for p in case_studies %}
{{ card(p, loop.index, case_studies | length, 'CASE STUDY') }}
  {% endfor %}
</div>
{% endblock %}
