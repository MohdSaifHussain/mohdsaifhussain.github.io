{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}

{% block scripts %}
<script src="/js/diagram.js" defer></script>
{% endblock %}

{% block jsonld %}
<script type="application/ld+json">{{ projects_jsonld }}</script>
{% endblock %}

{% block content %}

{# Handoff §3 (3a). The slider is native CSS scroll-snap — no JS carousel, no
   arrows. A3.2 in the animation list is precisely the declaration that this
   scrolling is native and nothing else moves; the layout is built here because
   the page cannot exist without it, and P3.3 verifies it against C-14/C-15 and
   records it in the audit list. Recorded as reading R-06.

   This is also the first page carrying BOTH marks — verified ✓ rows and
   TS-Sentry's pending ✗ — which discharges obligation O-9: MARK_DRIFT's first
   coverage of real dual-mark output. #}

<section class="section section--head">
  <div class="section-head">
    {# R-07, owner-directed deviation from handoff §3 (which specifies "Case
       ledger"): the h1 matches its nav label, per the anti-lost doctrine —
       C-13 wants the current location unambiguous. The ledger voice stays in
       the entries line below. #}
    <h1 class="display-lg">Projects</h1>
    <span class="mono-meta">{{ '%02d' % (projects | length) }} ENTRIES · SCROLL →</span>
  </div>
</section>

<div class="slider" tabindex="0" role="region" aria-label="Project case studies, scrollable">
  {% for p in projects %}
  <article class="card">

    <div class="card-head">
      <span class="numeral">{{ '%02d' % loop.index }}
        <span class="card-pos">/ {{ '%02d' % (projects | length) }}
          {%- if p.get('flagship') %} · FLAGSHIP{% elif p.get('archived') %} · ARCHIVED{% endif -%}
        </span>
      </span>
      {% if p.get('metrics_pending') %}
      <span class="card-status">{{ m.mark_cross() }}<span class="status--pending">METRICS PENDING</span></span>
      {% else %}
      <span class="card-status">{{ m.mark_check() }}<span class="status--verified">VERIFIED</span></span>
      {% endif %}
    </div>

    <h2 class="display-md">{{ p.name }}</h2>
    <p class="quote">{{ p.problem }}</p>

    <div class="card-grid">
      <div class="card-col">
        <span class="mono-label">METHOD</span>
        <p class="mono-body">{{ p.method }}</p>
      </div>
      <div class="card-col">
        <span class="mono-label">VERIFIED METRICS</span>
        <div class="metrics">
          {% for metric in p.verified_metrics %}
          <span class="metric">{{ m.mark_check() }}{{ metric }}</span>
          {% endfor %}
          {% if p.get('metrics_pending') %}
          <span class="metric metric--pending">{{ m.mark_cross() }}{{ p.get('metrics_pending') }}</span>
          {% endif %}
        </div>
        <p class="mono-meta card-basis">{{ p._basis_sentence }}</p>
      </div>
    </div>

    {% if p.get('diagram') %}
    {# v1.2 (P5.4): the project's own architecture, transcribed from its README
       by tools/gen_diagrams.py, posts node by node and draws its edges as the
       figure reaches the reading edge (A3.7). The figure scrolls sideways
       inside its own frame when it is wider than the card (native, C-14), and
       the zoom controls, revealed by diagram.js, scale the drawing inside that
       same frame. #}
    <figure class="diagram-wrap">
      <div class="diagram-head">
        <figcaption class="mono-label">ARCHITECTURE — FROM THE README</figcaption>
        <span class="diagram-zoom" role="group" aria-label="Zoom the {{ p.name }} diagram">
          <button type="button" class="d-zoom" data-zoom="out" aria-label="Zoom out">−</button>
          <button type="button" class="d-zoom" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" class="d-zoom" data-zoom="reset">RESET</button>
        </span>
      </div>
      {# The accessible name carries the project name: six regions named alike are
         one landmark six times to a screen reader, and axe refused the deploy
         for it (D-66). #}
      <div class="diagram-scroll" tabindex="0" role="region" aria-label="{{ p.name }} architecture diagram, scrollable">
        {% include 'diagrams/' ~ p.diagram ~ '.svg.j2' %}
      </div>
    </figure>
    {% endif %}

    <div class="card-foot">
      {% if p.get('ai_collaboration') %}
      <span class="mono-meta">{{ p.ai_collaboration }}</span>
      {% else %}<span></span>{% endif %}
      <div class="card-links">
        {% for label, url in p.links.items() %}
        <a class="mono-link" href="{{ url }}" rel="noopener noreferrer">{{ label | replace('_', ' ') | upper }} ↗</a>
        {% endfor %}
        {{ m.anchor(p._anchor, 'AS OF') }}
      </div>
    </div>

  </article>
  {% endfor %}
</div>
{% endblock %}
