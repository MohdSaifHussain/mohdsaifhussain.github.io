{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}
{% block content %}

{# Handoff §3 (3d), charter C-30. Row LABELS, TARGETS and the declared basis of
   observation-backed rows come from data/audit-spec.json. Everything else comes
   from data/generated/audit.json, which CI writes and no one hand-edits (C-35):

     measured{}  Lighthouse, the Nu validator and axe — measured against the
                 PUBLISHED ORIGIN (tools/write_audit.py)
     gates{}     the exit codes of the real gates, run against the COMMIT under
                 test (tools/gate_status.py, added for defect D-48)

   Two different subjects, so they are labelled separately rather than merged.
   When a value is absent the cell reads "— AT DEPLOY", which is the negative
   control for this whole pipeline: absence has to be visible, or a pipeline
   that has quietly stopped producing looks exactly like one that is working.
   D-48 was precisely that — eight A2 keys no writer had ever produced. #}

<section class="section section--head">
  <div class="section-head">
    {# R-07 site-wide: h1 matches the nav label ("A / AUDIT"). #}
    <h1 class="display-lg">Audit</h1>
    <span class="mono-meta">
      {%- if measured_as_of %}MEASURED {{ measured_as_of }}{% if measured_against %} AGAINST {{ measured_against | upper }}{% endif %}{% else %}NOT YET MEASURED{% endif -%}
      · STATS {{ github.as_of_display }}</span>
  </div>
</section>

<section class="section audit-tables">

  <div class="audit-table">
    <div class="audit-head audit-head--a1">
      <span class="mono-label">A1</span><span class="mono-label">STANDARDS</span>
      <span class="mono-label">TARGET</span><span class="mono-label">MEASURED</span>
    </div>
    {% for row in audit_spec.a1_standards %}
    <div class="audit-row audit-row--a1">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.standard }}</span>
      <span class="accent">{{ row.target }}</span>
      {% if measured.get(row.key) %}
      <span>{{ m.mark_check() }}{{ measured[row.key] }}</span>
      {% else %}
      <span class="mono-meta dim">— AT DEPLOY</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="audit-table">
    <div class="audit-head audit-head--a2">
      <span class="mono-label">A2</span><span class="mono-label">CHARTER CHECKS</span>
      <span class="mono-label">CONDITIONS</span><span class="mono-label">STATUS</span>
    </div>
    {# Defect D-48. Three distinct kinds of row, and they must not look alike:

       1. a GATE ran and its exit code is the verdict -> the mark and the gate's
          own name, so a reader can go run the same thing;
       2. no machine decides it — the claim rests on a person having looked ->
          the dated observation and a link to the record. NEVER a check mark:
          a verification mark next to an unverified claim is exactly what C-27
          exists to prevent;
       3. nothing has produced it yet -> "— AT DEPLOY", the honest absence.

       The old template had only branches 1 and 3, and branch 1's key was never
       written by anything, so all eight rows sat in branch 3 permanently. #}
    {% for row in audit_spec.a2_charter_checks %}
    {% set gate = gates.get(row.key) %}
    <div class="audit-row audit-row--a2">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.check }}</span>
      <span class="mono-meta dim">{{ row.conditions }}</span>
      {% if gate and gate.status == 'PASS' %}
      {# .get(), not .skipped: the checker-backed gates carry no skip count at
         all, and Jinja raises UndefinedError on a missing attribute. #}
      <span>{{ m.mark_check() }}{{ gate.producer }}{% if gate.get('skipped') %} · {{ gate.get('skipped') }} SKIPPED{% endif %}</span>
      {% elif gate %}
      <span>{{ m.mark_cross() }}FAILED — {{ gate.producer }}</span>
      {# .get() again: the build runs Jinja with StrictUndefined, so a missing
         key raises rather than reading as falsy. Only the observation-backed
         rows carry `basis`. #}
      {% elif row.get('basis') %}
      <span class="mono-meta">{{ row.get('basis') }} · <a class="mono-link" href="{{ row.get('evidence_url') }}" target="_blank" rel="noopener noreferrer">{{ row.get('evidence_label') }}</a></span>
      {% else %}
      <span class="mono-meta dim">— AT DEPLOY</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="audit-table">
    <div class="audit-head audit-head--a3">
      <span class="mono-label">A3</span><span class="mono-label">SHIPPED ANIMATIONS</span>
      <span class="mono-label">PROPERTIES</span><span class="mono-label">DURATION</span>
      <span class="mono-label">QUESTION IT ANSWERS</span>
    </div>
    {% for row in audit_spec.a3_animations %}
    <div class="audit-row audit-row--a3">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.animation }}</span>
      <span>{{ row.properties }}</span>
      <span>{{ row.duration }}</span>
      <span class="accent">{{ row.answers }}</span>
    </div>
    {% endfor %}
  </div>

  {# The protocol is published beside the scores it produced. A number whose
     method is unstated cannot be checked or repeated — and single-run figures
     were retired here after two consecutive runs of the same site differed by
     39 points. #}
  <p class="mono-meta audit-note">
    MEASUREMENT PROTOCOL — {{ measurement_protocol }}
  </p>

  {# Defect D-48 rewrote this note. It previously said, of every empty cell,
     that such scores "ARE MEASURED BY CI AT PUBLISH TIME" — which was not true
     of nine of the fourteen cells above, because nothing produced them and
     nothing ever had. It now describes what actually happens, and no more. #}
  <p class="mono-meta audit-note">
    {{ '%02d' % (audit_spec.a3_animations | length) }} ANIMATIONS SHIP. THE LIST CHANGES ONLY BY RECORDED RULING, NEVER SILENTLY — ANY UNDECLARED MOTION IS A DEFECT (C-12).
    A1 IS MEASURED AGAINST THE PUBLISHED ORIGIN. A2 IS THE RECORDED EXIT CODE OF THE NAMED GATE, RUN AGAINST {% if gates_commit %}COMMIT {{ gates_commit[:7] | upper }}{% else %}THE COMMIT UNDER TEST{% endif %}.
    ROWS THAT REST ON A PERSON HAVING LOOKED SAY SO, WITH THE DATE AND THE RECORD, AND CARRY NO VERIFICATION MARK.
    NOTHING ON THIS PAGE IS HAND-ENTERED (C-35); “— AT DEPLOY” MEANS NOTHING HAS PRODUCED THAT CELL YET.
    {% if not measured %}NO CI MEASUREMENT HAS RUN YET: THE MEASURED COLUMNS BELOW ARE HONESTLY EMPTY RATHER THAN OPTIMISTIC.{% endif %}
  </p>

  <div class="audit-table">
    <div class="audit-head audit-head--a4">
      <span class="mono-label">A4</span><span class="mono-label">KNOWN LIMITATIONS, DECLARED</span>
      <span class="mono-label">REASON</span>
    </div>
    {% for lim in limitations %}
    <div class="audit-row audit-row--a4">
      <span class="mono-meta dim">{{ lim.id }}</span>
      <span>{{ m.mark_cross() }}{{ lim.limitation }}</span>
      <span class="mono-meta">{{ lim.reason }}</span>
    </div>
    {% endfor %}

    {# Closed limitations stay published. A register showing only what is
       currently broken teaches nothing about how the posture got here, and a
       declaration that quietly disappears is indistinguishable from one never
       made. A limit leaves the active list only when it genuinely narrowed. #}
    {% for lim in resolved %}
    <div class="audit-row audit-row--a4 audit-row--resolved">
      <span class="mono-meta dim">{{ lim.id }}</span>
      <span>{{ m.mark_check() }}<s>{{ lim.limitation }}</s> — CLOSED {{ lim.closed }}</span>
      <span class="mono-meta">{{ lim.closed_by }}</span>
    </div>
    {% endfor %}
  </div>

</section>
{% endblock %}
