{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}
{% block content %}

{# Handoff §3 (3d), charter C-30. Row LABELS and TARGETS come from
   data/audit-spec.json. MEASURED values and STATUSES come from
   data/generated/audit.json, which CI writes from Lighthouse, axe and the Nu
   validator — never hand-entered (C-35). When that file is absent, as on any
   first deploy, the measured column reads "— AT DEPLOY". That absence is the
   negative control for this whole pipeline, and it is currently the live
   state: it is being demonstrated, not asserted. #}

<section class="section section--head">
  <div class="section-head">
    <h1 class="display-lg">Site audit</h1>
    <span class="mono-meta">SNAPSHOT AS OF {{ github.as_of_display }}</span>
  </div>
</section>

<section class="section audit-tables">

  <div class="audit-table">
    <div class="audit-head audit-head--a1">
      <span class="mono-label">A1</span><span class="mono-label">STANDARDS</span>
      <span class="mono-label">TARGET</span><span class="mono-label">MEASURED</span>
    </div>
    {% for row in audit_spec.a1_standards %}
    <div class="audit-row audit-row--a1">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.standard }}</span>
      <span class="accent">{{ row.target }}</span>
      {% if measured.get(row.key) %}
      <span>{{ m.mark_check() }}{{ measured[row.key] }}</span>
      {% else %}
      <span class="mono-meta dim">— AT DEPLOY</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="audit-table">
    <div class="audit-head audit-head--a2">
      <span class="mono-label">A2</span><span class="mono-label">CHARTER CHECKS</span>
      <span class="mono-label">CONDITIONS</span><span class="mono-label">STATUS</span>
    </div>
    {% for row in audit_spec.a2_charter_checks %}
    <div class="audit-row audit-row--a2">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.check }}</span>
      <span class="mono-meta dim">{{ row.conditions }}</span>
      {% if measured.get(row.key) %}
      <span>{{ m.mark_check() }}{{ measured[row.key] }}</span>
      {% else %}
      <span class="mono-meta dim">— AT DEPLOY</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="audit-table">
    <div class="audit-head audit-head--a3">
      <span class="mono-label">A3</span><span class="mono-label">SHIPPED ANIMATIONS</span>
      <span class="mono-label">PROPERTIES</span><span class="mono-label">DURATION</span>
      <span class="mono-label">QUESTION IT ANSWERS</span>
    </div>
    {% for row in audit_spec.a3_animations %}
    <div class="audit-row audit-row--a3">
      <span class="mono-meta dim">{{ row.id }}</span>
      <span>{{ row.animation }}</span>
      <span>{{ row.properties }}</span>
      <span>{{ row.duration }}</span>
      <span class="accent">{{ row.answers }}</span>
    </div>
    {% endfor %}
  </div>

  <p class="mono-meta audit-note">
    SHIPPED ANIMATIONS ARE {{ '%02d' % (audit_spec.a3_animations | length) }} AND THE LIST IS CLOSED — ANY OTHER MOTION IS A DEFECT (C-12).
    SCORES MARKED “— AT DEPLOY” ARE MEASURED BY CI AT PUBLISH TIME AND NEVER HAND-ENTERED (C-35).
    {% if not measured %}NO CI MEASUREMENT HAS RUN YET: THE MEASURED COLUMNS BELOW ARE HONESTLY EMPTY RATHER THAN OPTIMISTIC.{% endif %}
  </p>

  <div class="audit-table">
    <div class="audit-head audit-head--a4">
      <span class="mono-label">A4</span><span class="mono-label">KNOWN LIMITATIONS, DECLARED</span>
      <span class="mono-label">REASON</span>
    </div>
    {% for lim in limitations %}
    <div class="audit-row audit-row--a4">
      <span class="mono-meta dim">{{ lim.id }}</span>
      <span>{{ m.mark_cross() }}{{ lim.limitation }}</span>
      <span class="mono-meta">{{ lim.reason }}</span>
    </div>
    {% endfor %}
  </div>

</section>
{% endblock %}
