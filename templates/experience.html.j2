{% extends 'base.html.j2' %}
{% import '_macros.html.j2' as m %}
{% block content %}

{# R-07, elevated site-wide: every page h1 matches its nav label. The retired
   heading "Nine years, receipted" also hand-wrote a number ("Nine") that would
   go stale — contrary to the computed-counts rule. The ledger voice moves to
   the sub-line, where both figures are derived from data. #}

<section class="section section--head">
  <div class="section-head">
    <div class="head-stack">
      <h1 class="display-lg">Experience</h1>
      <span class="mono-meta">{{ '%02d' % (roles | length) }} ROLES, RECEIPTED · {{ profile.years_experience }} YEARS</span>
    </div>
    <a class="pdf-button" href="/assets/resume/MohdSaifHussain_Resume_Web.pdf">WEB RESUME (PDF) ↓</a>
  </div>
</section>

<section class="section section--table">
  <div class="xp-head">
    <span class="mono-label">NO.</span>
    <span class="mono-label">PERIOD</span>
    <span class="mono-label">ROLE</span>
    <span class="mono-label">RECEIPTS</span>
  </div>

  {% for role in roles %}
  <article class="xp-row">
    <span class="numeral-sm">{{ '%02d' % loop.index }}</span>
    <span class="mono-meta">{{ role.period | upper }}</span>
    <div class="xp-role">
      <span class="display-xs">{{ role.title }}</span>
      <span class="mono-meta">{{ role.company | upper }} · {{ role.location | upper }}</span>
    </div>
    <ul class="xp-receipts">
      {# D-25: the reference marks each receipt with a neutral accent dash, not
         a check. It is right on both counts — a ✓ on every resume bullet
         implies a verification that never happened (C-27), and the ✓/✗ motif
         must stay meaningful. The design's character is an em dash, which sits
         inside C-27's em-dash scope on this page; a CSS-drawn accent rule is
         the same mark visually, is the ledger-rule motif, and is not text. #}
      {% for h in role.highlights %}
      <li class="receipt"><span class="receipt-rule" aria-hidden="true"></span><span>{{ h }}</span></li>
      {% endfor %}
    </ul>
  </article>
  {% endfor %}

  <div class="xp-close">
    {% for e in education %}
    {# Middle dot, not an em dash: this page is inside C-27's em-dash scope
       (defect D-08), and check_content.py enforces that on the RENDERED page,
       so site chrome here is bound by the same rule as the data. #}
    <span class="mono-meta">EDUCATION · {{ e.degree | upper }} · {{ e.institution | upper }} · {{ e.graduated }}</span>
    {% endfor %}
    <span class="mono-meta">{{ '%02d' % (roles | length) }} ROLES · CONTACT VIA LINKEDIN ONLY</span>
  </div>
</section>
{% endblock %}
