{% import '_macros.html.j2' as m %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{# CSP first, so it governs everything that follows (C-18). Built from a
   structured definition in build.py; see there for the CSP3 §3.3 citation and
   for why frame-ancestors is deliberately absent rather than written-and-ignored. #}
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ page_title }} — {{ profile.wordmark }}</title>
<meta name="description" content="{{ page_description }}">
<link rel="canonical" href="{{ canonical }}">

{# C-25: Open Graph + Twitter card with a real image. The image is DRAWN from
   tokens.css by tools/gen_images.py, so it cannot drift from the site's own
   palette and mark. It is metadata and is never rendered in-page — which is
   why C-05 reports MET-not-applicable (A4.5 on /audit). #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ profile.wordmark }}">
<meta property="og:title" content="{{ page_title }} — {{ profile.wordmark }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ base_url }}/assets/img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ profile.wordmark }} — {{ profile.identity_line }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
<link rel="icon" href="/assets/img/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="{{ theme_color_dark }}" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="{{ theme_color_light }}" media="(prefers-color-scheme: light)">
{# Fonts are self-hosted and preloaded (C-04). `crossorigin` is required even
   same-origin: fonts are always fetched in CORS mode.
   Only the three faces used above the fold on every page are preloaded; the
   italic and semibold faces load normally. O-8: font-display is retained
   provisionally and measured against Lighthouse at P3.5. #}
<link rel="preload" href="/assets/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/IBMPlexMono-Medium.woff2" as="font" type="font/woff2" crossorigin>
{# One stylesheet: tokens + site concatenated at build time, so first
   paint waits on one round trip rather than two (O-8, LCP path). The
   sources remain two commented files. #}
<link rel="stylesheet" href="/css/site.css">
{# D-59. The ONLY render-blocking script the site loads, and the only one
   without `defer`. It applies a theme the visitor already chose this visit
   BEFORE first paint; deferred, it would repaint after the page is on screen,
   which is a visible flash of the wrong theme and indistinguishable from a bug.

   External for four lines because it has to be: the INLINE_SCRIPT gate refuses
   a <script> with a body and no src, and the CSP is script-src 'self' with no
   'unsafe-inline', no nonce and no hash. There is no inline route here.

   Placed AFTER the stylesheet so the tokens are already parsed when the
   attribute lands, and its cost is on the record — this is the one deliberate
   addition to a critical path whose LCP is declared UNMET. #}
<script src="/js/theme-init.js"></script>
{# C-26. application/ld+json is data, not executable script: it carries no
   `src` and runs nothing, so it does not breach C-18's no-inline-script rule.
   Contains NO email and no phone — C-33 covers structured data explicitly, and
   check_c33.py scans the rendered output. #}
{% block jsonld %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header>
  <nav aria-label="Primary">
    <span class="wordmark">{{ profile.wordmark }}</span>
    <ul class="nav-list">
      {% for item in nav %}
      <li>
        {%- if item.id == current -%}
        <span class="nav-link nav-link--current" aria-current="page">{{ item.label }}{{ m.mark_check() }}</span>
        {%- else -%}
        <a class="nav-link" href="{{ item.href }}">{{ item.label }}</a>
        {%- endif -%}
      </li>
      {% endfor %}
    </ul>
    {# P4.2. A CONTROL, not a destination: no 01–04 number prefix, because that
       scheme means "this is a place you can go" and this is a thing you press.
       Recorded as reading R-17.

       `hidden` until theme.js removes it — the toggle does nothing without
       script, and a control that cannot act is a dead affordance and a dead tab
       stop, which C-07 and the P3.3 tabindex ruling both refuse.

       The label is constant and the STATE lives in aria-pressed, which is the
       toggle-button pattern; a label that rewrites itself between "Light" and
       "Dark" is ambiguous about whether it names the current mode or the one
       you would get. Ref, checked 2026-08-10:
       https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Attributes/aria-pressed #}
    <button type="button" class="theme-toggle" data-theme-toggle
            aria-pressed="false" hidden>Light mode</button>
  </nav>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer>
  <div class="foot-row">
    <span class="wordmark-foot">{{ profile.wordmark }}</span>
    <div class="foot-links">
      <a class="mono-link" href="{{ profile.links.linkedin }}" rel="noopener noreferrer">LINKEDIN</a>
      <a class="mono-link" href="{{ profile.links.github }}" rel="noopener noreferrer">GITHUB</a>
      {# P5.2, decision 5.2.1: the visit counter is retired. D-03's dash was the
         designed state; a dash that looks like a broken counter is not. #}
    </div>
  </div>
  <p class="colophon">{{ colophon }} <a class="mono-link" href="/audit/">&rarr; /AUDIT</a></p>
</footer>
{# External scripts only (C-18). `defer` so neither blocks rendering (C-04).

   theme.js sits OUTSIDE the block deliberately: index.html.j2 overrides
   `scripts`, and an override replaces rather than appends, so a theme toggle
   declared inside the block would silently vanish from the Home page — the one
   page that overrides it. This is the first script the site loads on all five
   pages. #}
<script src="/js/theme.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
