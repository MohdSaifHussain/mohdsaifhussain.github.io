# Build output — regenerated by build.py, published by the Action as a Pages artifact.
# Not committed: the deployed site is always a product of data + templates (C-34).
_site/

# Font sources. The full upstream files are build inputs, not shipped artifacts.
# The SUBSET woff2 files under assets/fonts/ ARE committed — they are self-hosted (C-04).
build/fonts-src/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node tooling (Lighthouse CI / axe, wired in P3.5)
node_modules/
.lighthouseci/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# CI-written measurement output. Deliberately NOT committed: it is
# produced by the publishing environment on every deploy, and a copy in
# git could drift from what was actually measured (C-30, C-35).
data/generated/audit.json
vnu.json
axe.json
.lighthouseci/
